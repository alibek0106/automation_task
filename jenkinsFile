pipeline {
    agent any

    parameters {
        choice(
            name: 'BROWSER',
            choices: ['chromium', 'firefox', 'webkit', 'all'],
            description: 'Select browser to run tests on'
        )
    }

    stages {
        // stage('Checkout') {
        //     steps {
        //         echo 'Checking out repository...'
        //         git branch: 'main', url: 'https://github.com/Lukameladz3/Jenkins-Playwright-TS.git'
        //     }
        // }
        stage('Install Dependencies') {
            steps {
                script {
                    // Install pnpm if not already available
                    bat '''
                        @echo off
                        where pnpm >nul 2>&1
                        if %ERRORLEVEL% NEQ 0 (
                            echo Installing pnpm...
                            npm install -g pnpm@10.23.0
                        )
                    '''
                    
                    // Install dependencies with pnpm
                    // pnpm has built-in caching - it will reuse packages from its store
                    // The store persists in the Jenkins workspace, providing automatic caching
                    echo 'Installing dependencies with pnpm...'
                    bat 'pnpm install --frozen-lockfile'
                    
                    // Check if Playwright browsers are already installed
                    // This provides caching by skipping re-installation if browsers exist
                    def browserCheck = bat(
                        script: '@echo off && dir /b "%LOCALAPPDATA%\\ms-playwright" 2>nul | findstr /i "chromium" >nul && echo EXISTS || echo NOT_EXISTS',
                        returnStdout: true
                    ).trim()
                    
                    if (browserCheck.contains('EXISTS')) {
                        echo 'Playwright browsers already installed, skipping download...'
                    } else {
                        echo 'Installing Playwright browsers (this may take a few minutes on first run)...'
                        bat 'pnpm exec playwright install --with-deps'
                    }
                    
                    echo 'Dependencies installed'
                }
            }
        }

        stage('Run Tests') {
            steps {
                script {
                    def browser = params.BROWSER
                    def testCommand = 'pnpm exec playwright test --workers=4'
                    
                    if (browser == 'all') {
                        echo "Running tests on all browsers..."
                        bat testCommand
                    } else {
                        echo "Running tests on ${browser}..."
                        // Playwright project names are lowercase: chromium, firefox, webkit
                        bat "${testCommand} --project=${browser}"
                    }
                    
                    echo "${browser} tests finished"
                }
            }
        }
        stage('Publish HTML Report') {
            steps {
                echo 'Publishing Playwright HTML report...'
                publishHTML([
                    allowMissing: false,
                    alwaysLinkToLastBuild: true,
                    keepAll: true,
                    reportDir: 'playwright-report',    // folder containing index.html and all subfolders
                    reportFiles: 'index.html',         // index.html only
                    reportName: 'Playwright Test Report',
                    reportTitles: 'Playwright Test Report'
                ])
            }
        }

    }

    post {
        always {
            echo 'Archiving report files, screenshots, and videos...'
            archiveArtifacts artifacts: 'playwright-report/**', fingerprint: true
        }
    }
}